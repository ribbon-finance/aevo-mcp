# AEVO environment
AEVO_ENVIRONMENT=testnet

# API credentials (get from https://app.aevo.xyz/settings/api-keys)
AEVO_API_KEY=
AEVO_API_SECRET=

# Signing key for order submission (get from https://app.aevo.xyz/settings)
AEVO_SIGNING_KEY_PRIVATE_KEY=

# Wallet (only needed for register_account tool)
AEVO_WALLET_ADDRESS=

# Auto-register signing key + API key on startup (requires wallet keys)
AEVO_AUTO_REGISTER=false

# Transport
AEVO_MCP_TRANSPORT=stdio
AEVO_MCP_HOST=0.0.0.0
AEVO_MCP_PORT=8080
AEVO_MCP_PATH=/mcp
