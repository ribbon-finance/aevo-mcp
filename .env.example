# AEVO network
AEVO_ENVIRONMENT=mainnet
AEVO_API_BASE_URL=https://api.aevo.xyz
AEVO_WS_URL=wss://ws.aevo.xyz/ws

# Signing identities (minimal auth surface)
AEVO_ACCOUNT_ADDRESS=
AEVO_ACCOUNT_PRIVATE_KEY=
AEVO_SIGNING_KEY=
AEVO_SIGNING_KEY_PRIVATE_KEY=

# Optional static API credentials
AEVO_API_KEY=
AEVO_API_SECRET=

# Auto-register signing key + API key on startup
AEVO_AUTO_REGISTER=false

# Transport
AEVO_MCP_HOST=0.0.0.0
AEVO_MCP_PORT=8080
AEVO_MCP_PATH=/mcp
AEVO_MCP_TRANSPORT=streamable-http

# Request policy
AEVO_REQUEST_TIMEOUT_SECONDS=12
AEVO_REQUEST_RETRIES=3
AEVO_REQUEST_RETRY_BASE_MS=200
AEVO_REQUEST_ID_PREFIX=aevo-mcp
